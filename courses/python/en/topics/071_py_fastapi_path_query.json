    },
    {
      "type": "text",
      "text": "/books/12?limit=5",
      "size": 16,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " in ",
      "size": 16
    },
    {
      "type": "text",
      "text": "/docs",
      "size": 16,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": "; ",
      "size": 16
    },
    {
      "type": "text",
      "text": "book_id",
      "size": 16,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " is in the path and ",
      "size": 16
    },
    {
      "type": "text",
      "text": "limit",
      "size": 16,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " is in the query string after ",
      "size": 16
    },
    {
      "type": "text",
      "text": "?",
      "size": 16,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": ".\n\n",
      "size": 16
    }
  ],

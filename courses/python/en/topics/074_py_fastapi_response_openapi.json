    },
    {
      "type": "text",
      "text": "Answer: Inspect ",
      "size": 16
    },
    {
      "type": "text",
      "text": "/openapi.json",
      "size": 16,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": ", then test that an ",
      "size": 16
    },
    {
      "type": "text",
      "text": "internal_note",
      "size": 16,
      "bold": true,
      "color": "#1565C0"
    },

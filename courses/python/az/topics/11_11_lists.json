    {
      "type": "code",
      "language": "python",
      "code": "def main():\n    values = [4, 2, 4]\n    values.append(9)\n    values.extend([1, 7])\n    values.insert(1, 3)\n    values.remove(4)\n    removed = values.pop()\n    print(\"siyahı:\", values)\n    print(\"götürülən:\", removed)\n    print(\"index/count:\", values.index(4), values.count(4))\n    values.sort()\n    values.reverse()\n    snapshot = values.copy()\n    print(\"tərs sıralanmış:\", values)\n    print(\"surət:\", snapshot)\n    values.clear()\n    print(\"təmizlənmiş:\", values)\n\nif __name__ == \"__main__\":\n    main()",

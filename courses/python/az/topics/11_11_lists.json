      "code": "def main():\n    scores = [58, 91, 76, 91, 40]\n    print(scores[0], scores[-1])\n    print(scores[1:4], scores[::2], scores[::-1])\n    passed = [score for score in scores if score >= 70]\n    labels = [\"keçdi\" if score >= 70 else \"təkrar\" for score in scores]\n    print(passed)\n    print(labels)\n    scores[0:2] = [60, 92]\n    print(scores)\n\nif __name__ == \"__main__\":\n    main()",

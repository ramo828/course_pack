    {
      "type": "code",
      "language": "python",
      "code": "from dataclasses import dataclass\n\n@dataclass(slots=True)\nclass Point:\n    x: float\n    y: float\n\npoint = Point(3, 4)\nprint(point.x + point.y)",
      "showCopyButton": true
    },
    {
      "type": "text",
      "text": "ОЖИДАЕМЫЙ РЕЗУЛЬТАТ\n",

  "spans": [
    {
      "type": "text",
      "text": "ЗАЧЕМ ЭТО НУЖНО?\n",
      "size": 20,
      "color": "#1565C0",
      "bold": true
    },
    {
      "type": "text",
      "text": "Современные аннотации описывают контракты ",

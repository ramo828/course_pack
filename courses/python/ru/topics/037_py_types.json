      "color": "#212121"
    },
    {
      "type": "text",
      "text": "TypedDict",
      "size": 16,
      "color": "#1565C0",
      "bold": true
    },
    {
      "type": "text",
      "text": " и ",
      "size": 16,
      "color": "#212121"

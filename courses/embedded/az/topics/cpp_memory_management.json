      "type": "code",
      "language": "cpp",
      "code": "#include <stdint.h>\n#include <stddef.h>\n#include <stdlib.h>\n\nvoid setup() {\n  uint16_t samples[10];\n  const size_t bytes = sizeof(samples);\n  const size_t count = sizeof(samples) / sizeof(samples[0]);\n  (void)bytes;\n  (void)count;\n\n  uint8_t* buffer = static_cast<uint8_t*>(malloc(32));\n  if (buffer != nullptr) {\n    buffer[0] = 42;\n    uint8_t* cleared = static_cast<uint8_t*>(calloc(8, sizeof(uint16_t)));\n    if (cleared != nullptr) free(cleared);\n    void* resized = realloc(buffer, 64);\n    if (resized != nullptr) buffer = static_cast<uint8_t*>(resized);\n    free(buffer);\n    buffer = nullptr;\n  }\n\n  int* reading = new int(42);\n  delete reading;\n}\n\nvoid loop() {}",

      "type": "code",
      "language": "cpp",
      "code": "const unsigned long interval = 1000;\nunsigned long previous = 0;\nvoid setup() { Serial.begin(115200); }\nvoid loop() {\n  if (millis() - previous >= interval) {\n    previous = millis();\n    Serial.println(\"heartbeat\");\n  }\n}",

    {
      "type": "text",
      "text": " означает наличие, ",
      "size": 17
    },
    {
      "type": "text",
      "text": "None",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " — отсутствие. ",
      "size": 17
    },
    {
      "type": "text",
      "text": "match",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " или ",
      "size": 17
    },
    {
      "type": "text",
      "text": "if let",
      "size": 17,
      "bold": true,
      "color": "#1565C0"

    {
      "type": "code",
      "language": "rust",
      "code": "fn first_word(text: &str) -> &str {\n    text.split_whitespace().next().unwrap_or(\"\")\n}\nfn main() {\n    let sentence = String::from(\"Rust keeps data safe\");\n    let word = first_word(&sentence);\n    println!(\"{word}\");\n}",
      "showCopyButton": true
    },
    {
      "type": "text",
      "text": "ОЖИДАЕМЫЙ РЕЗУЛЬТАТ\n",

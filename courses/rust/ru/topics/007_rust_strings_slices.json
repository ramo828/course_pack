    {
      "type": "text",
      "text": "chars()",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " перебирает Unicode scalar values. Срез показывает часть текста или массива без копирования; функция с ",
      "size": 17
    },
    {
      "type": "text",
      "text": "&str",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " принимает и ",
      "size": 17
    },
    {
      "type": "text",
      "text": "String",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": ", и строковый литерал.\n\n",
      "size": 17
    },
    {
      "type": "text",
      "text": "РАЗБОР ВАЖНЫХ СТРОК\n",
      "size": 20,
      "color": "#6A1B9A",
      "bold": true
    },
    {
      "type": "text",
      "text": "Ключевая строка: ",
      "size": 16
    },

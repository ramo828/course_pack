    },
    {
      "type": "text",
      "text": "serde_json",
      "size": 17,
      "color": "#1565C0",
      "bold": true,
      "italic": true
    },
    {
      "type": "text",
      "text": " produces JSON and must be added to Cargo.\n\n",
      "size": 17,

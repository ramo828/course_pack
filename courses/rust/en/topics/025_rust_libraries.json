      "bold": true,
      "italic": true
    },
    {
      "type": "tip",
      "title": "Important tip",
      "text": "For the Serde example, run `cargo add serde --features derive` and `cargo add serde_json`; read the crate docs and keep secrets out of source code."
    },
    {
      "type": "text",
      "text": "SECOND PRACTICAL EXAMPLE\n",
      "size": 20,
      "color": "#1565C0",
      "bold": true
    },
    {
      "type": "code",
      "language": "rust",
      "code": "use serde::Serialize;\n#[derive(Serialize)]\nstruct Device { name: String, online: bool }\nfn main() -> Result<(), serde_json::Error> {\n    let device = Device { name: \"sensor-1\".into(), online: true };\n    println!(\"{}\", serde_json::to_string(&device)?);\n    Ok(())\n}\n// Add serde with the derive feature and serde_json in Cargo.toml.",
      "showCopyButton": true
    },
    {
      "type": "text",
      "text": "SECOND EXAMPLE RESULT\n",
      "size": 20,
      "color": "#2E7D32",
      "bold": true
    },
    {
      "type": "text",
      "text": "{\"name\":\"sensor-1\",\"online\":true}\n\n",
      "size": 16
    },
    {
      "type": "text",
      "text": "Tokio: async runtime and timers\n",
      "size": 20,
      "color": "#1565C0",
      "bold": true
    },
    {
      "type": "code",
      "language": "rust",
      "code": "#[tokio::main]\nasync fn main() {\n    tokio::time::sleep(std::time::Duration::from_millis(1)).await;\n    println!(\"task complete\");\n}",
      "showCopyButton": true
    },
    {
      "type": "text",
      "text": "SECOND EXAMPLE RESULT\n",
      "size": 20,
      "color": "#2E7D32",
      "bold": true
    },
    {
      "type": "text",
      "text": "task complete\n\n",
      "size": 16
    },
    {
      "type": "text",
      "text": "thiserror: a typed application error\n",
      "size": 20,
      "color": "#1565C0",
      "bold": true
    },
    {
      "type": "code",
      "language": "rust",
      "code": "#[derive(Debug, thiserror::Error)]\nenum PortError {\n    #[error(\"invalid port\")]\n    Invalid(#[from] std::num::ParseIntError),\n}\nfn parse_port(text: &str) -> Result<u16, PortError> {\n    Ok(text.parse()?)\n}\nfn main() {\n    match parse_port(\"bad\") {\n        Ok(port) => println!(\"{port}\"),\n        Err(error) => println!(\"{error}\"),\n    }\n}",
      "showCopyButton": true
    },
    {
      "type": "text",
      "text": "SECOND EXAMPLE RESULT\n",
      "size": 20,
      "color": "#2E7D32",
      "bold": true
    },
    {
      "type": "text",
      "text": "invalid port\n\n",
      "size": 16
    },
    {
      "type": "text",
      "text": "anyhow: application-level error context\n",
      "size": 20,
      "color": "#1565C0",
      "bold": true
    },
    {
      "type": "code",
      "language": "rust",
      "code": "use anyhow::Context;\nfn load_port(text: &str) -> anyhow::Result<u16> {\n    let port = text.parse::<u16>().context(\"port must be a number\")?;\n    anyhow::ensure!(port != 0, \"port must be non-zero\");\n    Ok(port)\n}\nfn main() {\n    match load_port(\"8080\") {\n        Ok(port) => println!(\"port={port}\"),\n        Err(error) => eprintln!(\"{error:#}\"),\n    }\n}",
      "showCopyButton": true
    },
    {
      "type": "text",
      "text": "SECOND EXAMPLE RESULT\n",
      "size": 20,
      "color": "#2E7D32",
      "bold": true

      "type": "text",
      "text": "chars()",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": " Unicode scalar değerlerini dolaşır. Slice, metin veya dizinin bir bölümünü kopyalamadan gösterir; ",
      "size": 17
    },
    {
      "type": "text",
      "text": "&str",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },

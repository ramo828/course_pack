      "bold": true,
      "color": "#1565C0"
    },
    {
      "type": "text",
      "text": ", ",
      "size": 17
    },
    {
      "type": "text",
      "text": "embedded-hal = \"1\"",
      "size": 17,
      "bold": true,
      "color": "#1565C0"
    },
